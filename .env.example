# Questline env vars
# Copy to .env.local and fill in values. Never commit .env.local.
# All client-exposed vars must use the EXPO_PUBLIC_ prefix.

# Phase 1.2 — Supabase
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Phase 5.1 — RevenueCat (subscriptions)
# Public SDK keys, one per platform. Get them from RC dashboard →
# Project settings → API keys → "Public app-specific API key".
# Server-side webhook secret is set via `supabase secrets set
# REVENUECAT_WEBHOOK_SECRET=...`, not here.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Phase 5.3 — legal pages (host the markdown in /legal/ via GitHub
# Pages / Notion / Termly / etc., then drop the public URLs here).
# Settings → Privacy / Terms buttons open these in an in-app browser.
# Both required by App Store / Play Console submission.
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=

# Phase 5 — analytics & crash reporting
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_SENTRY_DSN=
